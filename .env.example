# Copy to .env (`make setup` does it) and fill in. .env is git-ignored; never commit real values.
# Mirror every value into Railway: `railway variable set KEY=VALUE`. Names match app/config.py.
# Verify all of them with `make check-keys` (step 0.2).

# --- Anthropic (orchestrator: claude-sonnet-5-5) ---
ANTHROPIC_API_KEY=

# --- ElevenLabs Agents (voice) ---
ELEVENLABS_API_KEY=
# From the agent's page or POST /v1/convai/agents/create (step 1.1)
ELEVENLABS_AGENT_ID=
# Returned when the Twilio number is imported into ElevenLabs (step 1.1)
ELEVENLABS_PHONE_NUMBER_ID=
# Arrival/exception calls: same agent with a 10 s silence timer; created by scripts/apply_agent.py
ELEVENLABS_CALLBACK_AGENT_ID=

# --- Twilio (the "Shotgun" number; voice only, no SMS) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# E.164, e.g. +17345550100
TWILIO_PHONE_NUMBER=

# --- Neon Postgres (job table). Pooled string from the Neon console, with sslmode=require ---
DATABASE_URL=

# --- GitHub (coder worker) ---
# Fine-grained token on the demo repo: Issues, Pull requests, Contents read/write (merge needs
# Contents), plus Webhooks read/write for `make github-hook`
GITHUB_TOKEN=
GITHUB_DEMO_REPO=25danielc/shotgun-demo-app
# Shared with the demo repo's webhook (X-Hub-Signature-256). `openssl rand -hex 24`
GITHUB_WEBHOOK_SECRET=
# How you name the demo repo out loud; a code fix must name it (default "shotgun demo app")
GITHUB_REPO_SPOKEN=shotgun demo app

# --- Composio (Gmail worker, throwaway account) ---
COMPOSIO_API_KEY=
# Composio user_id that owns the Gmail connected account (not "default")
COMPOSIO_USER_ID=shotgun-demo
# Who "email Alex" means (step 3.2): "Alex=alex@example.com; Erica=erica@example.com". Keep real
# addresses out of git.
EMAIL_CONTACTS=

# --- Google Maps Platform (only the Routes API enabled on this key; research uses Claude web search, D15) ---
GOOGLE_MAPS_API_KEY=
# ETA destination for step 5.1 (D16). Personal: keep it out of git, set it in Railway too.
HOME_ADDRESS=
# Local time zone for spoken times and deadlines (Railway's clock is UTC)
TIMEZONE=America/Detroit

# --- Security ---
# Sent by the iOS Shortcut as header X-Shotgun-Secret. `openssl rand -hex 24`
EVENTS_SHARED_SECRET=
# Sent by ElevenLabs tool webhooks (stored as an ElevenLabs workspace secret). `openssl rand -hex 24`
TOOLS_SHARED_SECRET=
# Only this caller may talk to the agent (E.164)
ALLOWED_CALLER_NUMBER=

# --- Where calls ring (Daniel's iPhone, E.164) ---
MY_PHONE_NUMBER=

# --- Departure call policy (step 4.3, D17). Defaults shown; set CALL_POLICY=always for rehearsals ---
CALL_POLICY=auto
DEPARTURE_MIN_DRIVE_MINUTES=10
DEPARTURE_QUIET_MINUTES=30

# --- Unplug recap push (step 4.4): ntfy.sh topic, subscribed in the ntfy app on the iPhone ---
# Topics are public by name, so make it long and random: `echo shotgun-$(openssl rand -hex 12)`
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh

# --- Deploy: Railway public URL, no trailing slash (step 1.4) ---
PUBLIC_BASE_URL=

# --- Mission control: GET /dashboard?token=<DASHBOARD_TOKEN>; DEMO_MODE=true enables the simulate buttons ---
DASHBOARD_TOKEN=
DEMO_MODE=false
